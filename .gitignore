# terminu family template (tdp project/gitignore), copied to an app's
# .gitignore; replace kbu. The app's own lines go below the last one.
/kbu
/dist/
.local/
.idea/
.vscode/
.DS_Store
*.test
*.out
go.work
go.work.sum
# Claude Code: the maintainer's own instructions and settings stay out of git;
# harness's rules for the repo (.claude/rules/terminu.md) stay in.
CLAUDE.md
/.claude/*
!/.claude/rules/
/.claude/rules/*
!/.claude/rules/terminu.md
/kbu.exe
*.swp
*.swo
Thumbs.db
config.yaml
/AGENTS.md
.forge/
.checkpoints/
